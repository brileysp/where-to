#!/bin/sh
# 9 Nov 2026: runs before every commit: the type check and the guard tests (thinking cap, no new full reads of the places table, definition of done, rule sections).
# The whole suite and the interest status report run with `npm run check`. Skip once with `git commit --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
npx tsc --noEmit
npx vitest run tests/gemini tests/scripts tests/interests tests/db --maxWorkers=2
